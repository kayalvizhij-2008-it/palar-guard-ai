# PALAR GUARD AI — FRONTEND ENVIRONMENT CONFIGURATION

# Base URL of the deployed FastAPI backend API (default: http://127.0.0.1:8000 in dev)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional MapTiler API Key for photorealistic vector satellite basemaps (e.g. https://cloud.maptiler.com)
# When omitted, system defaults to high-definition Esri World Imagery & Carto Dark basemaps
VITE_MAPTILER_API_KEY=
