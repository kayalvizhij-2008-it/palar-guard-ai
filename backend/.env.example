# PALAR GUARD AI — BACKEND ENVIRONMENT CONFIGURATION

# SQLite (default local dev) or Supabase/Render PostgreSQL:
# Example Supabase URL:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./palar_guard.db

# JWT Secret Key (REQUIRED in production, minimum 32 random characters; never commit real keys)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_at_least_32_random_characters_before_production

# Allowed CORS Origins (comma-separated, never '*' in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://frontend-tau-kohl-99.vercel.app

# Environment Mode: development | production
ENVIRONMENT=development

# Explicit Initial Administrator Provisioning (recommended for first production boot or via CLI)
# INITIAL_ADMIN_EMAIL=admin@example.org
# INITIAL_ADMIN_PASSWORD=set_a_strong_unique_password
