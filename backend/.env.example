# PALAR GUARD AI — BACKEND ENVIRONMENT CONFIGURATION

# SQLite (default local) or PostgreSQL (e.g. postgresql://user:password@host/dbname)
DATABASE_URL=sqlite:///./palar_guard.db

# JWT & Session Secret Key
SECRET_KEY=palar_guard_ai_secret_key_change_in_production_2026

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://palar-guard-ai.vercel.app

# Environment Mode: development | production
ENVIRONMENT=development
